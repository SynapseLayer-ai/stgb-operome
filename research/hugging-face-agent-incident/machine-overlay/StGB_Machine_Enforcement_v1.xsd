  <xs:element name="OperomeStGBMachineEnforcement">
    <xs:annotation>
      <xs:appinfo>
        <ExternalCorpus id="stgb-operome-2026-06-10" role="source-derived-legal-substrate" actorTreatment="machine-is-not-a-natural-person"/>
        <SectionScopes>
          <Scope id="ME-BOUNDARY" section="Machine evaluation boundary">
            <Condition>ProposedMachineAction isnot null</Condition>
            <Description>Keeps source-faithful legal attribution separate from material machine-action evaluation.</Description>
            <Variables>
              <Variable>MachineControlHarness</Variable>
              <Variable>ProposedMachineAction</Variable>
              <Variable>SelectedStGBSection</Variable>
              <Variable>ActorIsNaturalPerson</Variable>
              <Variable>LegalAttributionResult</Variable>
              <Variable>MaterialEvaluationResult</Variable>
            </Variables>
          </Scope>
          <Scope id="ME-EVIDENCE" section="Goal and observation evidence">
            <Condition>ProposedMachineAction isnot null</Condition>
            <Description>Separates an auditable raw goal from exact material facts and gives trusted observations precedence.</Description>
            <Variables>
              <Variable>MachineControlHarness</Variable>
              <Variable>ProposedMachineAction</Variable>
              <Variable>RawMachineGoal</Variable>
              <Variable>RawGoalParsed</Variable>
              <Variable>GoalEvidenceSource</Variable>
              <Variable>StructuredGoalFacts</Variable>
              <Variable>TrustedObservedFacts</Variable>
              <Variable>ObservedFactPrecedenceApplied</Variable>
              <Variable>GoalFactConflict</Variable>
              <Variable>GoalFactOutsideSelectedSectionContract</Variable>
              <Variable>MachineActionBlocked</Variable>
            </Variables>
          </Scope>
          <Scope id="ME-SUBJECTIVE" section="Human subjective legal predicates">
            <Condition>SubjectiveElementStatus is "not_assessed_for_machine"</Condition>
            <Description>Prevents machine goals or observations from satisfying human subjective StGB predicates.</Description>
            <Variables>
              <Variable>MachineControlHarness</Variable>
              <Variable>SubjectiveElementsPresent</Variable>
              <Variable>SubjectiveElementsPivotal</Variable>
              <Variable>SubjectiveValuesSuppliedButIgnored</Variable>
              <Variable>SubjectiveElementStatus</Variable>
              <Variable>MachineActionEscalated</Variable>
            </Variables>
          </Scope>
          <Scope id="ME-AUTHORIZATION" section="External authorization">
            <Condition>ProposedMachineAction isnot null</Condition>
            <Description>Requires authorization to be verified outside the acting machine by a trusted capability broker.</Description>
            <Variables>
              <Variable>MachineControlHarness</Variable>
              <Variable>ProposedMachineAction</Variable>
              <Variable>AuthorizationDecision</Variable>
              <Variable>AuthorizationVerified</Variable>
              <Variable>AuthorizationSource</Variable>
              <Variable>AuthorizationScope</Variable>
              <Variable>ExternalCapabilityBroker</Variable>
              <Variable>MachineActionEscalated</Variable>
            </Variables>
          </Scope>
          <Scope id="ME-BLOCK" section="Blocking decision">
            <Condition>MachineActionBlocked is true</Condition>
            <Description>Blocks realised material conduct, negative authority, conflicting observations, or out-of-contract goal facts.</Description>
            <Variables>
              <Variable>MachineControlHarness</Variable>
              <Variable>MachineActionBlocked</Variable>
              <Variable>MachineActionExecutable</Variable>
              <Variable>GoalFactConflict</Variable>
              <Variable>GoalFactOutsideSelectedSectionContract</Variable>
              <Variable>AuthorizationDecision</Variable>
              <Variable>MaterialEvaluationResult</Variable>
            </Variables>
          </Scope>
          <Scope id="ME-ESCALATE" section="Escalation decision">
            <Condition>MachineActionEscalated is true</Condition>
            <Description>Escalates unresolved material facts, pivotal subjective predicates, and unknown or unverified positive authority.</Description>
            <Variables>
              <Variable>MachineControlHarness</Variable>
              <Variable>MachineActionEscalated</Variable>
              <Variable>MachineActionExecutable</Variable>
              <Variable>MaterialEvaluationResult</Variable>
              <Variable>SubjectiveElementsPivotal</Variable>
              <Variable>AuthorizationDecision</Variable>
              <Variable>AuthorizationVerified</Variable>
            </Variables>
          </Scope>
          <Scope id="ME-ALLOW" section="Allow decision">
            <Condition>MachineActionAllowed is true</Condition>
            <Description>Allows only a determined negative material result with externally verified positive authorization and no block or escalation.</Description>
            <Variables>
              <Variable>MachineControlHarness</Variable>
              <Variable>MachineActionAllowed</Variable>
              <Variable>MachineActionExecutable</Variable>
              <Variable>MachineActionBlocked</Variable>
              <Variable>MachineActionEscalated</Variable>
              <Variable>MaterialEvaluationResult</Variable>
              <Variable>AuthorizationDecision</Variable>
              <Variable>AuthorizationVerified</Variable>
            </Variables>
          </Scope>
