        <MachineProfiles>
          <MachineProfile scope="ME-PROFILE-UnauthorisedDataAccess" sectionId="UnauthorisedDataAccess" stgbRef="§202a" capabilities="network data" materialisation="direct">
            <Rationale>A machine can obtain access to protected data through network or system calls.</Rationale>
          </MachineProfile>
          <MachineProfile scope="ME-PROFILE-InterceptionOfData" sectionId="InterceptionOfData" stgbRef="§202b" capabilities="network data" materialisation="direct">
            <Rationale>A machine can technically capture non-public data transmissions.</Rationale>
          </MachineProfile>
          <MachineProfile scope="ME-PROFILE-PreparationOfDataAccess" sectionId="PreparationOfDataAccess" stgbRef="§202c" capabilities="network data code_execution" materialisation="direct">
            <Rationale>A machine can produce, obtain or share credentials and offence-purpose programs.</Rationale>
          </MachineProfile>
          <MachineProfile scope="ME-PROFILE-HandlingUnlawfullyObtainedData" sectionId="HandlingUnlawfullyObtainedData" stgbRef="§202d" capabilities="network data" materialisation="direct">
            <Rationale>A machine can procure, transmit or expose unlawfully obtained non-public data.</Rationale>
            <SubjectiveElement name="IntentToEnrichSelf" status="not_assessed_for_machine"/>
            <SubjectiveElement name="IntentToEnrichThirdParty" status="not_assessed_for_machine"/>
            <SubjectiveElement name="IntentToHarmAnother" status="not_assessed_for_machine"/>
          </MachineProfile>
          <MachineProfile scope="ME-PROFILE-ComputerFraud" sectionId="ComputerFraud" stgbRef="§263a" capabilities="network code_execution" materialisation="direct">
            <Rationale>A machine can manipulate data processing through programs, data or credentials.</Rationale>
            <SubjectiveElement name="ActsWithAdvantageIntention" status="not_assessed_for_machine"/>
          </MachineProfile>
          <MachineProfile scope="ME-PROFILE-DataAlteration" sectionId="DataAlteration" stgbRef="§303a" capabilities="filesystem data code_execution" materialisation="direct">
            <Rationale>A machine can delete, suppress, disable or alter data.</Rationale>
          </MachineProfile>
          <MachineProfile scope="ME-PROFILE-ComputerSabotage" sectionId="ComputerSabotage" stgbRef="§303b" capabilities="network filesystem code_execution" materialisation="direct">
            <Rationale>A machine can significantly disrupt important data processing.</Rationale>
            <SubjectiveElement name="ActsWithDetrimentIntention" status="not_assessed_for_machine"/>
          </MachineProfile>
          <MachineProfile scope="ME-PROFILE-DisruptionOfTelecommunications" sectionId="DisruptionOfTelecommunications" stgbRef="§317" capabilities="network code_execution" materialisation="direct">
            <Rationale>A machine can disable or endanger telecommunications operation.</Rationale>
          </MachineProfile>
