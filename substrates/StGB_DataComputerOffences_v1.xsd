        <xs:appinfo>
          <Computable name="HandlingUnlawfullyObtainedData" dataType="Boolean"><Definition>QualifyingData is true and DataGenerallyAccessible is false and DataFromUnlawfulAct is true and HandlingAct is true and LawfulOfficialOrProfessionalDuty is false</Definition></Computable>
        </xs:appinfo>
      </xs:annotation></xs:element>
      <xs:element name="FraudulentManipulation" type="xs:boolean" minOccurs="0"><xs:annotation>
        <xs:documentation>Layer: Core | Cascade: Agent | Prompt: [Computable] FraudulentManipulation. | Input: Computable</xs:documentation>
        <xs:appinfo>
          <Computable name="FraudulentManipulation" dataType="Boolean"><Definition>IncorrectProgramDesign is true or IncorrectOrIncompleteData is true or UnauthorisedUseOfData is true or UnauthorisedInterference is true</Definition></Computable>
        </xs:appinfo>
      </xs:annotation></xs:element>
      <xs:element name="ComputerFraud" type="xs:boolean" minOccurs="0"><xs:annotation>
        <xs:documentation>Layer: Core | Cascade: Agent | Prompt: [Computable] ComputerFraud. | Input: Computable</xs:documentation>
        <xs:appinfo>
          <Computable name="ComputerFraud" dataType="Boolean"><Definition>PropertyDamageToAnother is true and DataProcessingResultInfluenced is true and FraudulentManipulation is true</Definition></Computable>
        </xs:appinfo>
      </xs:annotation></xs:element>
      <xs:element name="DataImpairmentAct" type="xs:boolean" minOccurs="0"><xs:annotation>
        <xs:documentation>Layer: Core | Cascade: Agent | Prompt: [Computable] DataImpairmentAct. | Input: Computable</xs:documentation>
        <xs:appinfo>
          <Computable name="DataImpairmentAct" dataType="Boolean"><Definition>DataDeleted is true or DataSuppressed is true or DataRenderedUnusable is true or DataAltered is true</Definition></Computable>
        </xs:appinfo>
      </xs:annotation></xs:element>
      <xs:element name="DataAlteration" type="xs:boolean" minOccurs="0"><xs:annotation>
        <xs:documentation>Layer: Core | Cascade: Agent | Prompt: [Computable] DataAlteration. | Input: Computable</xs:documentation>
        <xs:appinfo>
          <Computable name="DataAlteration" dataType="Boolean"><Definition>QualifyingData is true and DataImpairmentAct is true and Authorised is false</Definition></Computable>
        </xs:appinfo>
      </xs:annotation></xs:element>
      <xs:element name="HardwareImpairment" type="xs:boolean" minOccurs="0"><xs:annotation>
        <xs:documentation>Layer: Core | Cascade: Agent | Prompt: [Computable] HardwareImpairment. | Input: Computable</xs:documentation>
        <xs:appinfo>
          <Computable name="HardwareImpairment" dataType="Boolean"><Definition>HardwareDestroyed is true or HardwareDamaged is true or HardwareRenderedUnusable is true or HardwareRemoved is true or HardwareAltered is true</Definition></Computable>
        </xs:appinfo>
      </xs:annotation></xs:element>
      <xs:element name="SabotageModality" type="xs:boolean" minOccurs="0"><xs:annotation>
        <xs:documentation>Layer: Core | Cascade: Agent | Prompt: [Computable] SabotageModality. | Input: Computable</xs:documentation>
        <xs:appinfo>
          <Computable name="SabotageModality" dataType="Boolean"><Definition>DataAlteration is true or (DataEnteredOrTransmitted is true and QualifyingData is true) or HardwareImpairment is true</Definition></Computable>
        </xs:appinfo>
      </xs:annotation></xs:element>
      <xs:element name="ComputerSabotage" type="xs:boolean" minOccurs="0"><xs:annotation>
        <xs:documentation>Layer: Core | Cascade: Agent | Prompt: [Computable] ComputerSabotage. | Input: Computable</xs:documentation>
        <xs:appinfo>
          <Computable name="ComputerSabotage" dataType="Boolean"><Definition>DataProcessingSignificantlyDisrupted is true and DataProcessingEssentialToAnother is true and SabotageModality is true</Definition></Computable>
        </xs:appinfo>
      </xs:annotation></xs:element>
