        <xs:appinfo>
          <Computable name="HandlingAct" dataType="Boolean"><Definition>DataObtained is true or DataProcuredForActor is true or DataProcuredForOtherPerson is true or DataTransferred is true or DataDisseminated is true or DataMadeAvailable is true</Definition></Computable>
        </xs:appinfo>
