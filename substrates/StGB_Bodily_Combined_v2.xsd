            <Variable>BelongsToHousehold</Variable>
            <Variable>DefencelessThroughFrailty</Variable>
            <Variable>DefencelessThroughIllness</Variable>
            <Variable>LeftInPower</Variable>
            <Variable>MaliciousNeglectHealthDamage</Variable>
            <Variable>RoughlyMaltreats</Variable>
            <Variable>SubordinateInWork</Variable>
            <Variable>Torments</Variable>
            <Variable>UnderCare</Variable>
            <Variable>UnderCustody</Variable>
            <Variable>VictimUnderEighteen</Variable>
            <Variable>ProtectedVictim</Variable>
            <Variable>AbusiveConduct</Variable>
            <Variable>CareRelationship</Variable>
            <Variable>AbuseOfPersonUnderCare</Variable>
          </Variables>
        </Scope>
