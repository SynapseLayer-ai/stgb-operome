      </xs:annotation></xs:element>
      <xs:element name="AbuseOfPersonUnderCare" type="xs:boolean" minOccurs="0"><xs:annotation>
        <xs:documentation>Layer: Core | Cascade: Agent | Prompt: [Computable] AbuseOfPersonUnderCare. | Input: Computable</xs:documentation>
        <xs:appinfo>
