        </xs:appinfo>
      </xs:annotation></xs:element>
  </xs:sequence></xs:complexType>
  <xs:element name="OperomeAbuseOfPersonUnderCare"><xs:complexType><xs:sequence>
        <xs:element name="Parties" type="S225_PartiesGroup" minOccurs="0"/>
        <xs:element name="Conduct" type="S225_ConductGroup" minOccurs="0"/>
        <xs:element name="ComputableVariables" type="S225_ComputableVariablesGroup" minOccurs="0"/>
  </xs:sequence></xs:complexType></xs:element>
