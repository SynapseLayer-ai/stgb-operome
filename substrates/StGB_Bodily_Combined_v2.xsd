        <xs:element name="Conduct" type="S223_ConductGroup" minOccurs="0"/>
        <xs:element name="ComputableVariables" type="S223_ComputableVariablesGroup" minOccurs="0"/>
  </xs:sequence></xs:complexType></xs:element>
  <xs:annotation><xs:appinfo>
      <SectionScopes>
        <Scope id="OUT-BodilyHarm" section="Bodily Harm">
          <Condition>BodilyHarm is true</Condition>
          <Description>Bodily Harm (objective Tatbestand).</Description>
          <Variables>
            <Variable>Actor</Variable>
            <Variable>DamagesHealth</Variable>
            <Variable>PhysicallyMaltreats</Variable>
            <Variable>BodilyHarm</Variable>
          </Variables>
        </Scope>
      </SectionScopes>
      <BusinessRules>
        <Rule id="BDH-R01" verb="" actor="Actor">PhysicallyMaltreats is true</Rule>
        <Rule id="BDH-R02" verb="" actor="Actor">DamagesHealth is true</Rule>
        <Rule id="BDH-R80" verb="scope note: the two conducts gated individually per the contract, disjunction in the composite; [BodilyHarm] is the act element to which the Section 228 consent exception attaches and the reference target of the Section 129a catalogue text; Section 224 has moved to Excluded, so its in-corpus mentions resolve as input only" actor="Actor">BodilyHarm is true</Rule>
        <Rule id="BDH-P0" verb="not realise" actor="Actor">not BodilyHarm</Rule>
      </BusinessRules>
  </xs:appinfo></xs:annotation>


  <xs:complexType name="S225_PartiesGroup"><xs:sequence>
