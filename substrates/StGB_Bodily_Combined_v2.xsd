      <xs:element name="UnderCustody" type="xs:boolean" minOccurs="0"><xs:annotation><xs:documentation>Layer: Core | Cascade: Session | Prompt: Element/Datum: the person is under the custody of {Actor}. | Input: Boolean</xs:documentation><xs:appinfo><SurfaceForm>the person is under the custody of {Actor}</SurfaceForm></xs:appinfo></xs:annotation></xs:element>
      <xs:element name="VictimUnderEighteen" type="xs:boolean" minOccurs="0"><xs:annotation><xs:documentation>Layer: Core | Cascade: Session | Prompt: Element/Datum: a person under eighteen years. | Input: Boolean</xs:documentation><xs:appinfo><SurfaceForm>a person under eighteen years</SurfaceForm></xs:appinfo></xs:annotation></xs:element>
  </xs:sequence></xs:complexType>
  <xs:complexType name="S225_ComputableVariablesGroup"><xs:sequence>
