        <Rule id="APU-R02" verb="" actor="None">DefencelessThroughFrailty is true</Rule>
        <Rule id="APU-R03" verb="" actor="None">DefencelessThroughIllness is true</Rule>
        <Rule id="APU-R04" verb="" actor="None">UnderCare is true</Rule>
        <Rule id="APU-R05" verb="" actor="None">UnderCustody is true</Rule>
        <Rule id="APU-R06" verb="" actor="None">BelongsToHousehold is true</Rule>
        <Rule id="APU-R07" verb="" actor="None">LeftInPower is true</Rule>
        <Rule id="APU-R08" verb="" actor="None">SubordinateInWork is true</Rule>
        <Rule id="APU-R09" verb="" actor="Actor">Torments is true</Rule>
        <Rule id="APU-R10" verb="" actor="Actor">RoughlyMaltreats is true</Rule>
        <Rule id="APU-R11" verb="" actor="Actor">MaliciousNeglectHealthDamage is true</Rule>
        <Rule id="APU-R80" verb="scope note: paragraph 1 whole, the three victim alternatives over the four care relationships (the care-or-custody pair split per the contract) over the three conducts; the malicious-neglect conduct carries its own health-damage result inside the conduct element" actor="Actor">AbuseOfPersonUnderCare is true</Rule>
