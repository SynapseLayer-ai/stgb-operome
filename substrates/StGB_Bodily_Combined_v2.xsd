      <xs:element name="DefencelessThroughIllness" type="xs:boolean" minOccurs="0"><xs:annotation><xs:documentation>Layer: Core | Cascade: Session | Prompt: Element/Datum: a person defenceless owing to illness. | Input: Boolean</xs:documentation><xs:appinfo><SurfaceForm>a person defenceless owing to illness</SurfaceForm></xs:appinfo></xs:annotation></xs:element>
