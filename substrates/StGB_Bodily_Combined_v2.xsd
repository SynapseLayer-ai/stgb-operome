      <xs:element name="PhysicallyMaltreats" type="xs:boolean" minOccurs="0"><xs:annotation><xs:documentation>Layer: Core | Cascade: Session | Prompt: Element/Datum: {Actor} physically maltreats another person. | Input: Boolean</xs:documentation><xs:appinfo><SurfaceForm>{Actor} physically maltreats another person</SurfaceForm></xs:appinfo></xs:annotation></xs:element>
  </xs:sequence></xs:complexType>
  <xs:complexType name="S223_ComputableVariablesGroup"><xs:sequence>
