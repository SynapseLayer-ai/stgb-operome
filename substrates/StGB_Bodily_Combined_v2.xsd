      <xs:element name="RoughlyMaltreats" type="xs:boolean" minOccurs="0"><xs:annotation><xs:documentation>Layer: Core | Cascade: Session | Prompt: Element/Datum: {Actor} roughly maltreats the person. | Input: Boolean</xs:documentation><xs:appinfo><SurfaceForm>{Actor} roughly maltreats the person</SurfaceForm></xs:appinfo></xs:annotation></xs:element>
      <xs:element name="SubordinateInWork" type="xs:boolean" minOccurs="0"><xs:annotation><xs:documentation>Layer: Core | Cascade: Session | Prompt: Element/Datum: the person is subordinate to {Actor} within a work relationship. | Input: Boolean</xs:documentation><xs:appinfo><SurfaceForm>the person is subordinate to {Actor} within a work relationship</SurfaceForm></xs:appinfo></xs:annotation></xs:element>
      <xs:element name="Torments" type="xs:boolean" minOccurs="0"><xs:annotation><xs:documentation>Layer: Core | Cascade: Session | Prompt: Element/Datum: {Actor} torments the person. | Input: Boolean</xs:documentation><xs:appinfo><SurfaceForm>{Actor} torments the person</SurfaceForm></xs:appinfo></xs:annotation></xs:element>
