        </xs:appinfo>
      </xs:annotation></xs:element>
      <xs:element name="AbusiveConduct" type="xs:boolean" minOccurs="0"><xs:annotation>
        <xs:documentation>Layer: Core | Cascade: Agent | Prompt: [Computable] AbusiveConduct. | Input: Computable</xs:documentation>
